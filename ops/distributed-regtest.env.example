# Copy to ops/distributed-regtest.env and edit for the six-server regtest run.

# Controller hosts bitcoind, miner/wallet management, and genesis nodes 1-4.
CONTROLLER_HOST=10.0.0.10
NODE1_HOST=10.0.0.10
NODE2_HOST=10.0.0.10
NODE3_HOST=10.0.0.10
NODE4_HOST=10.0.0.10

# Worker servers each run one Thornado full node, one Bifrost signer, and one
# node-local bitcoind peer. Bifrost wallet RPC still points to CONTROLLER_HOST.
NODE5_HOST=10.0.0.15
NODE6_HOST=10.0.0.16
NODE7_HOST=10.0.0.17
NODE8_HOST=10.0.0.18
NODE9_HOST=10.0.0.19

# Keep these aligned across all servers.
CHAIN_ID=thornado-e2e
SIGNER_PASSWD=passphrase123
BTC_RPC_PORT=24645
BTC_P2P_PORT=24646
API_BASE=2370
GRPC_BASE=13380
RPC_BASE=33360
P2P_BASE=33380
EBIFROST_BASE=58600
FROST_P2P_BASE=9340
FROST_INFO_BASE=10340
METRICS_BASE=14200
