FROM bitcoin/bitcoin:27 AS bitcoin

FROM golang:1.24-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=/root/.cargo/bin:/opt/bitcoin/bin:$PATH
ENV LD_LIBRARY_PATH=/workspace/target/release:/workspace/go-thornado/go-wrappers/frost/includes/linux/amd64:/workspace/go-thornado/go-wrappers/frost/includes/linux/arm64

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates clang curl git jq libssl-dev nodejs npm pkg-config procps python3 ripgrep sed xxd \
  && rm -rf /var/lib/apt/lists/*

COPY --from=bitcoin /opt/bitcoin-27.2 /opt/bitcoin

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal

WORKDIR /workspace
COPY . .

RUN cd circuits/tornado \
  && npm ci --omit=dev \
  && cd /workspace \
  && cargo build -p thornado-ffi --release --features proof-tests \
  && ./go-thornado/go-wrappers/frost/build-libgofrost.sh \
  && mkdir -p build \
  && cd go-thornado \
  && go build -tags 'regtest mocknet' -o ../build/thornado ./cmd/thornado \
  && go build -tags 'regtest mocknet' -o ../build/bifrost ./cmd/bifrost \
  && go build -tags 'regtest mocknet' -o ../build/thornado-ui ./cmd/thornado-ui \
  && go build -tags 'regtest mocknet' -o ../build/shielder-e2e-helper ./cmd/shielder-e2e-helper

CMD ["/workspace/ops/scripts/real-4node-e2e.sh"]
