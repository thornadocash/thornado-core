COMPOSE_PROFILES=mock

BITCOIND_IMAGE=bitcoin/bitcoin:27
CLIENT_IMAGE=alpine:3.20

BITCOIN_RPC_USER=thornado
BITCOIN_RPC_PASSWORD=thornado

RUST_LOG=info

# Optional integration hooks. Leave empty until the owning workstream exposes
# a real command.
THORNADO_BOOTSTRAP_CMD=
FROST_DKG_CMD=
FROST_DKG_STATUS_CMD=
SEND_DEPOSIT_CMD=
RUN_WITHDRAWAL_CMD=
DEPOSIT_AMOUNT_BTC=1

MINER_WALLET=miner
CLIENT_WALLET=client
BOOTSTRAP_BLOCKS=101
CLIENT_FUNDS_BTC=25
LOCALNET_HEALTH_TIMEOUT_SECONDS=180
